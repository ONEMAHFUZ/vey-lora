# VEY LORA — copy to .env.local and fill in. NEVER commit real secrets.
# Neon (PostgreSQL): DATABASE_URL = POOLED connection (host ends -pooler.neon.tech).
# DIRECT_URL = DIRECT connection (no -pooler), used ONLY by `prisma migrate deploy`.
DATABASE_URL="postgresql://user:password@localhost:5432/veylora?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/veylora?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# Stripe (test mode only until the business/payment account is authorised)
STRIPE_SECRET_KEY="sk_test_PLACEHOLDER"
STRIPE_PUBLISHABLE_KEY="pk_test_PLACEHOLDER"
STRIPE_WEBHOOK_SECRET="whsec_PLACEHOLDER"
# AI providers — leave empty until configured; demos fall back to the labelled LOCAL DEMO provider
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_PROVIDER="local-demo"
# Phase B — live TEXT providers ($0 free tiers, no card needed).
# Keys are server-side ONLY. Never put them in client code or commit them.
# Gemini: create a key at Google AI Studio (aistudio.google.com).
# Groq: create a key at Groq Console (console.groq.com).
GEMINI_API_KEY=""
GROQ_API_KEY=""
# Provider order tried by the router (default: Gemini -> Groq).
AI_PROVIDER_ORDER="gemini,groq"
# Model IDs (override if the provider retires/renames a model).
GEMINI_MODEL_LITE="gemini-3.5-flash-lite"
GEMINI_MODEL="gemini-3.6-flash"
GROQ_MODEL="openai/gpt-oss-120b"
